doctype html
html
    head
        meta(charset="utf-8")
        //- Everything the game needs is served from its own origin.
        meta(http-equiv="Content-Security-Policy", content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none';")
        title Trans&diams;cube
        link(rel="icon", type="image/png", href="media/img/cube.png")
        link(rel="stylesheet", type="text/css", href="css/main.css")
    body
        #container
            canvas#canvas
            #ui
                #levelselect
                    .title Level select
                    #levels
                    #menu
                        .menu Title
                        .restart Restart
                        .play Resume
                #intro
                    #title Trans<span>cube</span>
                    #slug a game by <a href="https://github.com/jeroenverfallie">jeroen verfallie</a>
                    #play Play
                    #github Github

                #end
                    #stats
                        div
                            span#time
                            span.right Seconds
                        div
                            span#restarts
                            span.right Restarts
                        div
                            span#transforms
                            span.right Transforms
                        div
                            span#deaths
                            span.right Deaths
                    #btns
                        .menu Menu
                        .retry Restart
                        .next &gt;&gt; Next level (N) &gt;&gt;
            #leveltitle.message.top Loading the loader!
            #icons-top
                .left
                    .menu
                    .pause
                    .restart
                .right
                    .music
                    .mute
            #footer
                #morphs
                    span Spawns a movable block you can stand on.
                    div


        script(type="text/javascript", src="js/soundmanager2-nodebug-jsmin.js")
        script(type="text/javascript", src="js/jquery.min.js")
        script(type="text/javascript", src="js/jquery.color.min.js")
        if dev
            script(type="text/javascript", src="js/main.js")
        else
            script(type="text/javascript", src="js/main.min.js")
